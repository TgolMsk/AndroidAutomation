{
  "name": "@avdm/automation",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Android game automation contracts, template vision and game plugins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wanlong": {
      "types": "./dist/wanlong/index.d.ts",
      "default": "./dist/wanlong/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
